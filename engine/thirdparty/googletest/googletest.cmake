set(GOOGLETEST_ROOT "${CMAKE_CURRENT_LIST_DIR}/.tmp/install")
set(GOOGLETEST_INCLUDE_DIR "${GOOGLETEST_ROOT}/Release/include")
set(GOOGLETEST_DEBUG_LIB_DIR "${GOOGLETEST_ROOT}/Debug/lib")
set(GOOGLETEST_RELEASE_LIB_DIR "${GOOGLETEST_ROOT}/Release/lib")

add_library(gtest SHARED IMPORTED GLOBAL)
set_target_properties(gtest PROPERTIES 
    INTERFACE_INCLUDE_DIRECTORIES "${GOOGLETEST_INCLUDE_DIR}"
    IMPORTED_CONFIGURATIONS "Debug;Release"

    IMPORTED_IMPLIB_DEBUG "${GOOGLETEST_DEBUG_LIB_DIR}/gtest.lib"
    IMPORTED_IMPLIB_RELEASE "${GOOGLETEST_RELEASE_LIB_DIR}/gtest.lib"

    MAP_IMPORTED_CONFIG_DEVELOP Debug
    MAP_IMPORTED_CONFIG_PROFILE Release
    MAP_IMPORTED_CONFIG_OPTIMIZE Release
    MAP_IMPORTED_CONFIG_SHIPPING Release
    MAP_IMPORTED_CONFIG_RELWITHDEBINFO Release
    MAP_IMPORTED_CONFIG_MINSIZEREL Release
)

add_library(gtest_main SHARED IMPORTED GLOBAL)
set_target_properties(gtest_main PROPERTIES 
    INTERFACE_INCLUDE_DIRECTORIES "${GOOGLETEST_INCLUDE_DIR}"
    IMPORTED_CONFIGURATIONS "Debug;Release"

    IMPORTED_IMPLIB_DEBUG "${GOOGLETEST_DEBUG_LIB_DIR}/gtest_main.lib"
    IMPORTED_IMPLIB_RELEASE "${GOOGLETEST_RELEASE_LIB_DIR}/gtest_main.lib"

    INTERFACE_LINK_LIBRARIES gtest

    MAP_IMPORTED_CONFIG_DEVELOP Debug
    MAP_IMPORTED_CONFIG_PROFILE Release
    MAP_IMPORTED_CONFIG_OPTIMIZE Release
    MAP_IMPORTED_CONFIG_SHIPPING Release
    MAP_IMPORTED_CONFIG_RELWITHDEBINFO Release
    MAP_IMPORTED_CONFIG_MINSIZEREL Release
)

