set(GOOGLE_BENCHMARK_ROOT "${CMAKE_CURRENT_LIST_DIR}/.tmp/install")
set(GOOGLE_BENCHMARK_INCLUDE_DIR "${GOOGLE_BENCHMARK_ROOT}/Release/include")
set(GOOGLE_BENCHMARK_DEBUG_LIB_DIR "${GOOGLE_BENCHMARK_ROOT}/Debug/lib")
set(GOOGLE_BENCHMARK_RELEASE_LIB_DIR "${GOOGLE_BENCHMARK_ROOT}/Release/lib")

add_library(benchmark STATIC IMPORTED GLOBAL)
set_target_properties(benchmark PROPERTIES 
    INTERFACE_INCLUDE_DIRECTORIES "${GOOGLE_BENCHMARK_INCLUDE_DIR}"
    IMPORTED_CONFIGURATIONS "Debug;Release"

    INTERFACE_COMPILE_DEFINITIONS "BENCHMARK_STATIC_DEFINE"

    IMPORTED_LOCATION_DEBUG "${GOOGLE_BENCHMARK_DEBUG_LIB_DIR}/benchmark.lib"
    IMPORTED_LOCATION_RELEASE "${GOOGLE_BENCHMARK_RELEASE_LIB_DIR}/benchmark.lib"

    MAP_IMPORTED_CONFIG_DEVELOP Debug
    MAP_IMPORTED_CONFIG_PROFILE Release
    MAP_IMPORTED_CONFIG_OPTIMIZE Release
    MAP_IMPORTED_CONFIG_SHIPPING Release
    MAP_IMPORTED_CONFIG_RELWITHDEBINFO Release
    MAP_IMPORTED_CONFIG_MINSIZEREL Release
)

target_link_libraries(benchmark INTERFACE Shlwapi)

add_library(benchmark_main STATIC IMPORTED GLOBAL)
set_target_properties(benchmark_main PROPERTIES 
    INTERFACE_INCLUDE_DIRECTORIES "${GOOGLE_BENCHMARK_INCLUDE_DIR}"
    IMPORTED_CONFIGURATIONS "Debug;Release"

    INTERFACE_COMPILE_DEFINITIONS "BENCHMARK_STATIC_DEFINE"

    IMPORTED_IMPLIB_DEBUG "${GOOGLE_BENCHMARK_DEBUG_LIB_DIR}/benchmark_main.lib"
    IMPORTED_IMPLIB_RELEASE "${GOOGLE_BENCHMARK_RELEASE_LIB_DIR}/benchmark_main.lib"

    INTERFACE_LINK_LIBRARIES benchmark

    MAP_IMPORTED_CONFIG_DEVELOP Debug
    MAP_IMPORTED_CONFIG_PROFILE Release
    MAP_IMPORTED_CONFIG_OPTIMIZE Release
    MAP_IMPORTED_CONFIG_SHIPPING Release
    MAP_IMPORTED_CONFIG_RELWITHDEBINFO Release
    MAP_IMPORTED_CONFIG_MINSIZEREL Release
)