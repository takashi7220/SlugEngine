set(MIMALLOC_ROOT "${CMAKE_CURRENT_LIST_DIR}/.tmp/install")
set(MIMALLOC_INCLUDE_DIR "${MIMALLOC_ROOT}/Release/include")
set(MIMALLOC_DEBUG_LIB_DIR "${MIMALLOC_ROOT}/Debug/lib")
set(MIMALLOC_RELEASE_LIB_DIR "${MIMALLOC_ROOT}/Release/lib")

add_library(mimalloc SHARED IMPORTED GLOBAL)
set_target_properties(mimalloc PROPERTIES 
    INTERFACE_INCLUDE_DIRECTORIES "${MIMALLOC_INCLUDE_DIR}"
    IMPORTED_CONFIGURATIONS "Debug;Release"

    IMPORTED_IMPLIB_DEBUG "${MIMALLOC_DEBUG_LIB_DIR}/mimalloc-debug.lib"
    IMPORTED_IMPLIB_RELEASE "${MIMALLOC_RELEASE_LIB_DIR}/mimalloc.lib"

    MAP_IMPORTED_CONFIG_DEVELOP Debug
    MAP_IMPORTED_CONFIG_PROFILE Release
    MAP_IMPORTED_CONFIG_OPTIMIZE Release
    MAP_IMPORTED_CONFIG_SHIPPING Release
    MAP_IMPORTED_CONFIG_RELWITHDEBINFO Release
    MAP_IMPORTED_CONFIG_MINSIZEREL Release
)